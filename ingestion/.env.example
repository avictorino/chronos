# --- LLM provider ---
# "ollama" (default, fully local) or "openai" (hosted, enables higher LLM_CONCURRENCY)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
# Any chat-capable model already pulled locally works. Swap for qwen3:14b, llama3.1, etc.
OLLAMA_MODEL=qwen3.5:9b
# Any embedding model already pulled locally works. Swap for nomic-embed-text, etc.
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Only required when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# How many pending items (events/people/places/...) are sent to the LLM concurrently
# within a single expansion loop iteration. Only helps if Ollama itself can serve
# that many requests at once — set OLLAMA_NUM_PARALLEL to match (Windows env var,
# needs an Ollama restart to take effect) or this just queues client-side with no
# benefit. Raise to 4-8 when LLM_PROVIDER=openai.
LLM_CONCURRENCY=1

# --- Firestore (the only datastore — see app/persistence/firestore.py) ---
# `ingest` writes directly to Firestore (Firebase, free Spark plan); the
# frontend reads the same collections directly, no server in between.
FIREBASE_PROJECT_ID=chronos-29b82
# Path to a service-account JSON key (Admin SDK — never the frontend's web
# config). Leave empty to fall back to ambient Application Default
# Credentials (e.g. after `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Ingestion limits (kept small for V1 so a run is cheap to test) ---
MAX_EVENTS_PER_CIVILIZATION=10
MAX_PEOPLE_PER_CIVILIZATION=20
MAX_PLACES_PER_CIVILIZATION=20
MAX_POLITIES_PER_CIVILIZATION=10
MAX_RELATIONSHIPS_PER_ENTITY=30
MAX_EXPANSION_DEPTH=2

# --- Entity resolution ---
# Whether to fall back to an LLM tiebreaker call for ambiguous (borderline-score) matches.
ENTITY_RESOLUTION_USE_LLM=false

# --- LangGraph checkpointing ---
INGESTION_CHECKPOINT_DB_PATH=.data/checkpoints.db

# --- Logging ---
# INFO for normal runs, DEBUG to also log prompts/raw LLM responses.
LOG_LEVEL=INFO
